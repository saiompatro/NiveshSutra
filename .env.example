# NiveshSutra — Local Configuration
# Copy this file to .env and adjust as needed.

# Database (default: SQLite file in project root)
# DATABASE_URL=sqlite:///./niveshsutra.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/niveshsutra

# FastAPI server
FASTAPI_PORT=8000
ENVIRONMENT=development

# Frontend API URL (must match the backend address)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Market data cache (seconds)
MARKET_DATA_CACHE_TTL_SECONDS=60
